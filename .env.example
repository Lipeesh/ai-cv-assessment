# Environment Configuration Template for AjnaLens AI/CV Assessment
# Duplicate this file to .env and adjust variables as required

# General
APP_ENV=development
DEBUG=True
DEVICE=cuda:0  # Set to 'cpu' if no CUDA GPU is available

# Paths
DATA_DIR=./data
CONFIGS_DIR=./configs
OUTPUTS_DIR=./outputs

# Task 1: Zone Monitoring
TASK1_PEOPLE_MODEL=../runs/people_yolo11/yolo11m_people_100e/weights/best.pt
TASK1_HELMET_MODEL=../runs/helmet_yolo11/yolo11m_helmet_100e/weights/best.pt
TASK1_INPUT_VIDEO=../runs/test/videoplayback.mp4

# Task 2: Helmet Detector
TASK2_WEIGHTS=../runs/helmet_yolo11/yolo11m_helmet_100e/weights/best.pt
TASK2_ONNX_MODEL=./task2/outputs/best.onnx

# Task 3: OCR
TESSERACT_CMD=/usr/bin/tesseract

# Task 4: RAG Engine
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_DB_DIR=./task4/data/chroma_db
RAG_HOST=0.0.0.0
RAG_PORT=8000
